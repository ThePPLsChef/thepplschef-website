# The PPL's Chef — Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit actual secrets to the repository.

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Google reCAPTCHA v3
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Dashboard
# Base64-encoded bcrypt hash, never a plaintext password.
ADMIN_PASSWORD_HASH=base64_encoded_bcrypt_hash_here
# Separate cryptographically random signing secret (at least 32 bytes).
# Provision only with CEO-approved configuration/deployment; never commit its value.
ADMIN_SESSION_SECRET=

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
